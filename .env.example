# Copy to .env.local (npm run setup does this for you and fills in a random secret).
# Never put real passwords in this file: it is committed to git.

# Public address of the site. Used in email links and SEO tags.
SITE_URL=http://localhost:3000

# Required. Signs tokens and encrypts CNIC files, receipts and the stored SMTP password.
# npm run setup creates a random one. Keep it safe: if it changes, stored CNIC documents can no longer be decrypted.
APP_SECRET=

DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE"
# SHADOW_DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE_shadow"

# SMTP. These can also be set in Admin > Email server; admin values take priority.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Al Zaujain Marriage Bureau <no-reply@example.com>"

# The website the mobile app opens automatically (built into the APK by npm run app:build).
APP_SITE_URL=https://alzaujain.com

# Cloudinary for the homepage banners and the director's photo (public images only).
# Leave empty to keep those images on this server instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
